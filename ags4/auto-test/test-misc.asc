// Test Misc Module Script
int GetTestMiscCount()
{
  return 2;
}

// Compiler: a void function may return the result of another void function (Draconian)
int _void_return_calls;

void _VoidReturnTarget()
{
  _void_return_calls++;
}

void _VoidReturnsVoid()
{
  return _VoidReturnTarget();
}

void _VoidReturnsVoidEarly(bool early)
{
  if (early)
    return _VoidReturnTarget();
  _void_return_calls += 10;
}

void TestMisc()
{
  tap.Comment("start Misc tests");

  // Compiler: "return <void expression>;" in a void function
  {
    _void_return_calls = 0;
    _VoidReturnsVoid();
    tap.is_int(_void_return_calls, 1, "Compiler: void function can return a void call");
    _void_return_calls = 0;
    _VoidReturnsVoidEarly(true);
    tap.is_int(_void_return_calls, 1, "Compiler: return of a void call exits the function");
  }

  tap.Comment("end Misc tests");
}