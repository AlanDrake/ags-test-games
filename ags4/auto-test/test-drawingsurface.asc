// Test DrawingSurface Module Script
int GetTestDrawingSurfaceCount()
{
  return 17 + 32;
}

#define SPR_DRAW_CIRCLE         1
#define SPR_DRAW_LINE           2
#define SPR_DRAW_RECTANGLE      3
#define SPR_DRAW_TRIANGLE       4
#define SPR_PLAIN_TEST          5

#define COLOR_BLACK             0xFF000000
#define COLOR_TEAL              0xFF295552
#define COLOR_TEAL_LIGHT        0xFF52AAAD
#define COLOR_RED_LIGHT         0xFFAD555A
#define COLOR_BLUE_DARK         0xFF292C73
#define COLOR_GREEN_LIGHT       0xFF42DB73
#define COLOR_WHITE             0xFFFFFFFF
#define COLOR_MAROON            0xFF420421
#define COLOR_YELLOW_DARK       0xFFD6A621
#define COLOR_PURPLE            0xFF844DEF


DynamicSprite* _CreateSpriteAlpha(int w, int h)
{
  return DynamicSprite.Create(w, h);
}

// Shape tests below draw COLOR_TEAL_LIGHT over COLOR_TEAL and probe pixels that must
// (or must not) be covered, so they don't depend on the exact rasterization.
void _IsDrawn(DrawingSurface* surface, int x, int y, String what)
{
  tap.is_int(surface.GetPixel(x, y), COLOR_TEAL_LIGHT, what);
}

void _IsNotDrawn(DrawingSurface* surface, int x, int y, String what)
{
  tap.is_int(surface.GetPixel(x, y), COLOR_TEAL, what);
}

DrawingSurface* _BeginShapeTest(DynamicSprite* dynspr)
{
  DrawingSurface* surface = dynspr.GetDrawingSurface();
  surface.Clear(COLOR_TEAL);
  surface.DrawingColor = COLOR_TEAL_LIGHT;
  return surface;
}

// Primitives added in AGS 4.0.0.33 Draconian (DrawingSurface primitive drawing functions).
// Angles are in degrees, counted counter-clockwise from 3 o'clock: 0..90 is the upper-right quarter.
void _TestDrawingSurfacePrimitives()
{
  DynamicSprite* dynspr = _CreateSpriteAlpha(32, 32);
  DrawingSurface* surface;

  // DrawingSurface.DrawEllipse (filled), rx = 10, ry = 5
  surface = _BeginShapeTest(dynspr);
  surface.DrawEllipse(16, 16, 10, 5);
  _IsDrawn(surface, 16, 16, "DrawingSurface.DrawEllipse fills the center");
  _IsDrawn(surface, 24, 16, "DrawingSurface.DrawEllipse fills along the x radius");
  _IsDrawn(surface, 16, 13, "DrawingSurface.DrawEllipse fills along the y radius");
  _IsNotDrawn(surface, 16, 24, "DrawingSurface.DrawEllipse does not draw outside the y radius");
  surface.Release();

  // DrawingSurface.DrawEllipseOutline
  surface = _BeginShapeTest(dynspr);
  surface.DrawEllipseOutline(16, 16, 10, 5);
  _IsNotDrawn(surface, 16, 16, "DrawingSurface.DrawEllipseOutline leaves the center empty");
  _IsDrawn(surface, 26, 16, "DrawingSurface.DrawEllipseOutline draws the right extreme");
  _IsDrawn(surface, 16, 11, "DrawingSurface.DrawEllipseOutline draws the top extreme");
  _IsDrawn(surface, 16, 21, "DrawingSurface.DrawEllipseOutline draws the bottom extreme");
  surface.Release();

  // DrawingSurface.DrawCircleOutline, radius = 8
  surface = _BeginShapeTest(dynspr);
  surface.DrawCircleOutline(16, 16, 8);
  _IsNotDrawn(surface, 16, 16, "DrawingSurface.DrawCircleOutline leaves the center empty");
  _IsDrawn(surface, 24, 16, "DrawingSurface.DrawCircleOutline draws the right extreme");
  _IsDrawn(surface, 8, 16, "DrawingSurface.DrawCircleOutline draws the left extreme");
  _IsDrawn(surface, 16, 8, "DrawingSurface.DrawCircleOutline draws the top extreme");
  _IsDrawn(surface, 16, 24, "DrawingSurface.DrawCircleOutline draws the bottom extreme");
  surface.Release();

  // DrawingSurface.DrawPie (filled), 0..90 degrees
  surface = _BeginShapeTest(dynspr);
  surface.DrawPie(16, 16, 10, 0, 90);
  _IsDrawn(surface, 20, 12, "DrawingSurface.DrawPie fills inside its angle range");
  _IsNotDrawn(surface, 12, 12, "DrawingSurface.DrawPie leaves the upper-left quarter empty");
  _IsNotDrawn(surface, 12, 20, "DrawingSurface.DrawPie leaves the lower-left quarter empty");
  _IsNotDrawn(surface, 20, 20, "DrawingSurface.DrawPie leaves the lower-right quarter empty");
  surface.Release();

  // DrawingSurface.DrawPieOutline, 0..90 degrees
  surface = _BeginShapeTest(dynspr);
  surface.DrawPieOutline(16, 16, 10, 0, 90);
  _IsNotDrawn(surface, 20, 12, "DrawingSurface.DrawPieOutline leaves its inside empty");
  _IsDrawn(surface, 21, 16, "DrawingSurface.DrawPieOutline draws the radius at 0 degrees");
  _IsDrawn(surface, 16, 11, "DrawingSurface.DrawPieOutline draws the radius at 90 degrees");
  _IsNotDrawn(surface, 12, 20, "DrawingSurface.DrawPieOutline leaves other quarters empty");
  surface.Release();

  // DrawingSurface.DrawArc, 0..90 degrees
  surface = _BeginShapeTest(dynspr);
  surface.DrawArc(16, 16, 10, 0, 90);
  _IsDrawn(surface, 26, 16, "DrawingSurface.DrawArc draws its start at 0 degrees");
  _IsDrawn(surface, 16, 6, "DrawingSurface.DrawArc draws its end at 90 degrees");
  _IsNotDrawn(surface, 16, 16, "DrawingSurface.DrawArc does not draw the radiuses");
  _IsNotDrawn(surface, 6, 16, "DrawingSurface.DrawArc does not draw outside its angle range");
  surface.Release();

  // DrawingSurface.DrawRectangleOutline
  surface = _BeginShapeTest(dynspr);
  surface.DrawRectangleOutline(4, 4, 20, 12);
  _IsDrawn(surface, 4, 4, "DrawingSurface.DrawRectangleOutline draws the top-left corner");
  _IsDrawn(surface, 20, 12, "DrawingSurface.DrawRectangleOutline draws the bottom-right corner");
  _IsNotDrawn(surface, 10, 8, "DrawingSurface.DrawRectangleOutline leaves the inside empty");
  surface.Release();

  // DrawingSurface.DrawTriangleOutline
  surface = _BeginShapeTest(dynspr);
  surface.DrawTriangleOutline(2, 2, 28, 4, 14, 28);
  _IsDrawn(surface, 2, 2, "DrawingSurface.DrawTriangleOutline draws the 1st vertex");
  _IsDrawn(surface, 28, 4, "DrawingSurface.DrawTriangleOutline draws the 2nd vertex");
  _IsDrawn(surface, 14, 28, "DrawingSurface.DrawTriangleOutline draws the 3rd vertex");
  _IsNotDrawn(surface, 14, 11, "DrawingSurface.DrawTriangleOutline leaves the inside empty");
  surface.Release();

  dynspr.Delete();
}

void TestDrawingSurface()
{  
  tap.Comment("start DrawingSurface tests");
  
  // DrawingSurface.GetPixel, DrawingSurface.Clear, DrawingSurface.DrawPixel
  {
    DynamicSprite* dynspr = _CreateSpriteAlpha(16, 16);
    DrawingSurface* surface = dynspr.GetDrawingSurface();
    
    surface.Clear(COLOR_TEAL);
    tap.is_int(surface.GetPixel(0, 0), COLOR_TEAL, "DrawingSurface.Clear sets the color of the surface (1)");
    tap.is_int(surface.GetPixel(5, 5), COLOR_TEAL, "DrawingSurface.Clear sets the color of the surface (2)");
    tap.is_int(surface.GetPixel(15, 15), COLOR_TEAL, "DrawingSurface.Clear sets the color of the surface (3)");
    surface.DrawingColor = COLOR_TEAL_LIGHT;
    surface.DrawPixel(1, 1);
    surface.DrawPixel(7, 2);
    tap.is_int(surface.GetPixel(0, 0), COLOR_TEAL, "DrawingSurface.DrawPixel works (1)");
    tap.is_int(surface.GetPixel(1, 1), COLOR_TEAL_LIGHT, "DrawingSurface.DrawPixel works (2)");
    tap.is_int(surface.GetPixel(2, 1), COLOR_TEAL, "DrawingSurface.DrawPixel works (3)");
    tap.is_int(surface.GetPixel(2, 2), COLOR_TEAL, "DrawingSurface.DrawPixel works (4)");
    tap.is_int(surface.GetPixel(7, 2), COLOR_TEAL_LIGHT, "DrawingSurface.DrawPixel works (5)");
    tap.is_int(surface.GetPixel(7, 1), COLOR_TEAL, "DrawingSurface.DrawPixel works (6)");
    tap.is_int(surface.GetPixel(7, 3), COLOR_TEAL, "DrawingSurface.DrawPixel works (7)");
    tap.is_int(surface.GetPixel(6, 2), COLOR_TEAL, "DrawingSurface.DrawPixel works (8)");
    tap.is_int(surface.GetPixel(8, 2), COLOR_TEAL, "DrawingSurface.DrawPixel works (9)");
    surface.Release();
    dynspr.Delete();
  }
  
  
  // DrawingSurface.DrawCircle
  {
    DynamicSprite* dynspr = _CreateSpriteAlpha(32, 16);
    DrawingSurface* surface = dynspr.GetDrawingSurface();
    
    surface.Clear(COLOR_RED_LIGHT);
    surface.DrawingColor = COLOR_BLUE_DARK;
    surface.DrawCircle(5, 8, 5);
    surface.DrawCircle(14, 8, 6);
    surface.DrawCircle(20, 9, 10);
    
    surface.Release();
    
    tap.ok(GfxComparer.MatchSprites(dynspr.Graphic, SPR_DRAW_CIRCLE), "DrawingSurface.DrawCircle works");
    
    dynspr.Delete();    
  }

  // DrawingSurface.DrawLine
  {
    DynamicSprite* dynspr = _CreateSpriteAlpha(32, 16);
    DrawingSurface* surface = dynspr.GetDrawingSurface();
    
    surface.Clear(COLOR_RED_LIGHT);
    surface.DrawingColor = COLOR_BLUE_DARK;
    surface.DrawLine(0, 0, 8, 8, 3);
    surface.DrawLine(5, 1, 15, 11);
    surface.DrawLine(8, 8, 31, 8);
    surface.DrawLine(16, 0, 16, 15);
    surface.DrawingColor = COLOR_GREEN_LIGHT;
    surface.DrawLine(5, 7, 3, 3);
    surface.DrawLine(25, 13, 9, 14);
    surface.DrawingColor = COLOR_WHITE;
    surface.DrawLine(14, 0, 14, 1);

    surface.Release();

    tap.ok(GfxComparer.MatchSprites(dynspr.Graphic, SPR_DRAW_LINE), "DrawingSurface.DrawLine works");

    dynspr.Delete();    
  }

  // DrawingSurface.DrawRectangle
  {
    DynamicSprite* dynspr = _CreateSpriteAlpha(32, 16);
    DrawingSurface* surface = dynspr.GetDrawingSurface();
    
    surface.Clear(COLOR_MAROON);
    surface.DrawingColor = COLOR_YELLOW_DARK;
    surface.DrawRectangle(5, 5, 12, 6);
    surface.DrawRectangle(8, 8, 31, 14);
    surface.DrawingColor = COLOR_PURPLE;
    surface.DrawRectangle(11, 13, 11, 18);
    surface.DrawRectangle(15, 6, 25, 15);

    surface.Release();

    tap.ok(GfxComparer.MatchSprites(dynspr.Graphic, SPR_DRAW_RECTANGLE), "DrawingSurface.DrawRectangle works");
    
    dynspr.Delete();    
  }

  // DrawingSurface.DrawTriangle
  {
    DynamicSprite* dynspr = _CreateSpriteAlpha(32, 16);
    DrawingSurface* surface = dynspr.GetDrawingSurface();
    
    surface.Clear(COLOR_RED_LIGHT);
    surface.DrawingColor = COLOR_BLUE_DARK;
    surface.DrawTriangle(1, 2, 4, 5, 3, 9);
    surface.DrawTriangle(23, 10, 31, 15, 20, 6);
    surface.DrawingColor = COLOR_GREEN_LIGHT;
    surface.DrawTriangle(5, 6, 8, 15, 0, 16);
    
    surface.Release();
    
    tap.ok(GfxComparer.MatchSprites(dynspr.Graphic, SPR_DRAW_TRIANGLE), "DrawingSurface.DrawTriangle works");

    dynspr.Delete();
  }

  _TestDrawingSurfacePrimitives();

  // Room.GetDrawingSurface
  {
    DrawingSurface* surface = Room.GetDrawingSurfaceForBackground(0);
    surface.Clear(COLOR_BLACK);
    surface.DrawImage(50, 50, SPR_PLAIN_TEST);
    surface.Release();
    Wait(1);
    
    tap.ok(GfxComparer.TakeScreenshotAndMatchSprite(50, 50, Game.SpriteWidth[SPR_PLAIN_TEST], Game.SpriteHeight[SPR_PLAIN_TEST], SPR_PLAIN_TEST), 
      "Room.GetDrawingSurfaceForBackground: drawing works");
  }
  
  // Cleanup
  DrawingSurface* surface = Room.GetDrawingSurfaceForBackground(0);
  surface.Clear(COLOR_BLACK);
  surface.Release();
  
  tap.Comment("end DrawingSurface tests");
}